# =============================================================================
# WireDeck2 Environment Configuration Template
# Copy to deploy/.env and replace all placeholder values before deployment.
# =============================================================================

# --- Domain & TLS ---
ROOT_DOMAIN=wiredeck.example.com
ACME_EMAIL=admin@example.com
COOKIE_SECURE=true
LOG_LEVEL=INFO
ENABLE_OPENAPI_DOCS=false

# --- Network CIDRs (must match docker network subnets; expanded on K8s) ---
CONTROL_NET_CIDR=172.21.0.0/20
RESERVED_CIDRS=172.21.0.0/20,172.22.0.0/20

# --- External Pinned Images (NEVER use :latest) ---
WIRERELAY_IMAGE_URL=ghcr.io/szomorxvigyor/wirerelay:v1.1.0
MAILGOPHER_IMAGE_URL=ghcr.io/szomorxvigyor/mailgopher:v1.2.0

# --- Bootstrap Platform Admin (idempotent; applied only if 0 platform admins exist) ---
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=change-me-strong-password

# --- JWT RS256 Signing Key (base64-encoded PKCS#8 PEM; generate via openssl genpkey) ---
# Example: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
JWT_PRIVATE_KEY_B64=
JWT_KEY_ID=v1

# --- Cryptographic Keys (32 random bytes, base64-encoded; MUST be distinct per service) ---
# Example: openssl rand -base64 32
WG_CONF_ENCRYPTION_KEY=
VNC_PASSWORD_ENCRYPTION_KEY=
RUNNER_TOKEN_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=

# --- OLTP PostgreSQL 18 ---
OLTP_ADMIN_USER=postgres
OLTP_ADMIN_PASSWORD=change-me-oltp-admin
IAM_DB_PASSWORD=change-me-iam-db
ORCHESTRATOR_DB_PASSWORD=change-me-orchestrator-db
WEBVNC_DB_PASSWORD=change-me-webvnc-db
WEBVIEW_DB_PASSWORD=change-me-webview-db

# --- Dedicated TimescaleDB (History TSDB) ---
TSDB_ADMIN_USER=postgres
TSDB_ADMIN_PASSWORD=change-me-tsdb-admin
TSDB_HISTORY_PASSWORD=change-me-tsdb-history

# --- MailGopher SMTP Accounts (JSON array; limit_per_hour MUST be >= 1) ---
SMTP_ACCOUNTS='[{"host":"smtp.example.com","port":"587","user":"noreply@example.com","pass":"change-me","limit_per_hour":300,"ssl":false}]'
