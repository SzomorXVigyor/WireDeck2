# =============================================================================
# WireDeck Local Testing Environment (Local Build Images, Plain HTTP, No Certs)
# Copy to deploy/.env.local and fill in generated crypto keys.
# =============================================================================

# --- Local HTTP Ingress (http://localhost:8080, Mailpit UI: http://localhost:18025) ---
LOCAL_HTTP_BIND=0.0.0.0
LOCAL_HTTP_PORT=8080
LOCAL_RUNNER_CONF_DIR=/tmp/wiredeck-local-runners
LOG_LEVEL=INFO
ENABLE_OPENAPI_DOCS=true
DEV_DIRECT_DIAL=false

# --- Network CIDRs ---
CONTROL_NET_CIDR=172.30.248.0/24
INGRESS_NET_CIDR=172.30.249.0/24
RUNNERS_NET_CIDR=172.30.252.0/22
RESERVED_CIDRS=172.30.248.0/24,172.30.252.0/22

# --- External Pinned Images ---
WIRERELAY_IMAGE_URL=ghcr.io/szomorxvigyor/wirerelay:v1.1.0
MAILGOPHER_IMAGE_URL=ghcr.io/szomorxvigyor/mailgopher:v1.2.0

# --- Bootstrap Platform Admin ---
INIT_ADMIN_EMAIL=admin@wiredeck.local
INIT_ADMIN_PASSWORD=AdminPassword!2026

# --- JWT RS256 Signing Key (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0) ---
JWT_PRIVATE_KEY_B64=
JWT_KEY_ID=v1

# --- Cryptographic Keys (openssl rand -base64 32) ---
WG_CONF_ENCRYPTION_KEY=
VNC_PASSWORD_ENCRYPTION_KEY=
RUNNER_TOKEN_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=

# --- Local DB Passwords ---
OLTP_ADMIN_USER=postgres
OLTP_ADMIN_PASSWORD=localoltpadmin
IAM_DB_PASSWORD=iampass
ORCHESTRATOR_DB_PASSWORD=orchpass
WEBVNC_DB_PASSWORD=vncpass
WEBVIEW_DB_PASSWORD=viewpass

TSDB_ADMIN_USER=postgres
TSDB_ADMIN_PASSWORD=localtsdbadmin
TSDB_HISTORY_PASSWORD=historypass
